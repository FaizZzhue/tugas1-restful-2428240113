{
  "info": {
    "_postman_id": "e0d93b68-5f2a-4a58-bd93-8f9a0d34c411",
    "name": "Tugas 2 - Movies MongoDB API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "api_key",
      "value": "isi-dengan-api-key-di-env"
    },
    {
      "key": "cinemaId",
      "value": ""
    },
    {
      "key": "movieId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API Info",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Cinemas",
      "item": [
        {
          "name": "List Cinemas",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinemas"
          }
        },
        {
          "name": "Create Cinema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Cinema Postman\",\n  \"lokasi\": \"Palembang\",\n  \"alamat\": \"Jl. Contoh, Palembang\",\n  \"fasilitas\": [\n    \"Regular\",\n    \"Parking\"\n  ]\n}"
            },
            "url": "{{base_url}}/cinemas"
          }
        },
        {
          "name": "Get Cinema By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinemas/{{cinemaId}}"
          }
        }
      ]
    },
    {
      "name": "Movies - Main Endpoint Query Features",
      "item": [
        {
          "name": "List Movies",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies"
          }
        },
        {
          "name": "Filtering - Genre",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies?genre=Drama"
          }
        },
        {
          "name": "Filtering - Search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies?search=senja"
          }
        },
        {
          "name": "Pagination",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies?page=1&limit=2"
          }
        },
        {
          "name": "Sorting",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies?sortBy=judul&order=asc"
          }
        },
        {
          "name": "Projection",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies?fields=judul,genre,durasiMenit"
          }
        },
        {
          "name": "Combined Query",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies?genre=Drama&page=1&limit=5&sortBy=judul&order=asc&fields=judul,genre,cinema"
          }
        },
        {
          "name": "Get Movie By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/movies/{{movieId}}"
          }
        },
        {
          "name": "Create Movie (Embedded Cast + Cinema Reference)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Film Uji MongoDB\",\n  \"genre\": \"Drama\",\n  \"durasiMenit\": 120,\n  \"ratingUsia\": \"13+\",\n  \"sutradara\": \"Sutradara Uji\",\n  \"cinemaId\": \"GANTI_DENGAN_OBJECT_ID_CINEMA\",\n  \"pemeran\": [\n    {\n      \"nama\": \"Aktor Pertama\",\n      \"peran\": \"Tokoh A\"\n    },\n    {\n      \"nama\": \"Aktris Kedua\",\n      \"peran\": \"Tokoh B\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/movies"
          }
        },
        {
          "name": "Update Movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Film Uji MongoDB Updated\",\n  \"genre\": \"Drama\",\n  \"durasiMenit\": 125,\n  \"ratingUsia\": \"13+\",\n  \"sutradara\": \"Sutradara Uji\",\n  \"cinemaId\": \"GANTI_DENGAN_OBJECT_ID_CINEMA\",\n  \"pemeran\": [\n    {\n      \"nama\": \"Aktor Pertama\",\n      \"peran\": \"Tokoh Utama\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/movies/{{movieId}}"
          }
        },
        {
          "name": "Delete Movie",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/movies/{{movieId}}"
          }
        }
      ]
    }
  ]
}