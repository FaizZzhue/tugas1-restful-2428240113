  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test(\"Status code harus 404\", function () {\r",
          "    pm.response.to.have.status(404);\r",
          "});\r",
          "\r",
          "pm.test(\"Pesan menyatakan film tidak ditemukan\", function () {\r",
          "    const response = pm.response.json();\r",
          "\r",
          "    pm.expect(response.status).to.eql(\"error\");\r",
          "    pm.expect(response.message).to.eql(\r",
          "        \"Data dengan id 99999 tidak ditemukan\"\r",
          "    );\r",
          "});\r",
          "\r",
          "pm.test(\"Data respons bernilai null\", function () {\r",
          "    const response = pm.response.json();\r",
          "\r",
          "    pm.expect(response.data).to.eql(null);\r",
          "});"
        ],
        "type": "text/javascript"
      }
    }
